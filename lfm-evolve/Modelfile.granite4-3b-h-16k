# IBM Granite 4.0 H-Micro 3B: Mamba-2 + attention hybrid (non-transformer), default tag 1.9 GB; twin of granite4-3b-16k
FROM granite4:3b-h
PARAMETER num_ctx 16384
# num_thread 4: llama.cpp otherwise spins one CPU thread per core the machine advertises, and under a
# container CPU quota that spinning stalls every step (H100 box, 2026-11-05: 2.5x slower per call,
# no gain from parallel slots). The GPU does the work; 4 threads are plenty for the CPU side.
PARAMETER num_thread 4
